---
import MainLayout from '@/layouts/MainLayout.astro';
import { Image } from 'astro:assets';
import { SITE, CONTACT } from '@data/constants';
import imgReviewSumit from '@images/reviews/sumith_shetty.png';
import imgReviewPradum from '@images/reviews/PRADUM_DHURIYA.png';
import imgReviewBanita from '@images/reviews/banita.png';

// Maps a testimonial's `image` key (see CONTACT.testimonials) to its imported asset.
const reviewAvatars: Record<string, ImageMetadata> = {
  sumith_shetty: imgReviewSumit,
  PRADUM_DHURIYA: imgReviewPradum,
  banita: imgReviewBanita,
};

const pageTitle = `Leave Us a Google Review | ${SITE.title}`;
const metaDescription =
  'Enjoyed your visit to MA Infotech? Leave us a quick review on Google Maps — it takes less than a minute and helps other Mumbaikars find us.';
const wrap = 'mx-auto w-full max-w-[48rem] px-4 sm:px-6 lg:px-8';
const wideWrap = 'mx-auto w-full max-w-[64rem] px-4 sm:px-6 lg:px-8';
const reviews = CONTACT.googleReviews;
const testimonials = CONTACT.testimonials;

const steps = [
  {
    title: 'Tap the button below',
    desc: 'It opens the Google review box directly in a new tab.',
  },
  {
    title: 'Sign in with Google',
    desc: 'Only if you’re not already signed in.',
  },
  {
    title: 'Rate us & share a few words',
    desc: 'Even a line or two makes a big difference. Thank you!',
  },
];
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={pageTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${SITE.url}/review`,
    url: `${SITE.url}/review`,
    name: pageTitle,
    description: metaDescription,
    isPartOf: {
      '@type': 'WebSite',
      url: SITE.url,
      name: SITE.legalName,
      description: SITE.description,
    },
    inLanguage: 'en-US',
  }}
>
  {/* ─── HERO ─────────────────────────────────────────────────────────── */}
  <section class="mesh-hero relative overflow-hidden">
    <div
      class="grid-pattern pointer-events-none absolute inset-0"
      aria-hidden="true"
    >
    </div>
    <div
      class="brand-glow brand-glow--navy -top-24 -left-24 h-96 w-96"
      aria-hidden="true"
    >
    </div>
    <div
      class="brand-glow brand-glow--red top-20 -right-16 h-96 w-96"
      aria-hidden="true"
    >
    </div>

    <div class={`${wrap} relative py-16 text-center sm:py-20 lg:py-24`}>
      <span class="eyebrow mx-auto">
        <span class="h-1.5 w-1.5 rounded-full bg-red-500"></span>
        Your feedback matters
      </span>

      <h1
        class="font-display text-ink mt-6 text-3xl text-balance sm:text-4xl lg:text-[2.75rem]"
      >
        Loved our service?{' '}
        <span class="text-gradient block sm:inline">
          Tell Mumbaikars about it</span
        >
      </h1>

      <p
        class="text-body mx-auto mt-5 max-w-lg text-base leading-relaxed sm:text-lg"
      >
        A quick Google review helps your neighbours find genuine, reliable tech
        help — and it means a lot to our team.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        {/* Overlapping reviewer photos */}
        <div class="flex -space-x-3">
          {
            [imgReviewSumit, imgReviewPradum, imgReviewBanita].map(img => (
              <Image
                src={img}
                alt=""
                width={72}
                height={72}
                loading="eager"
                class="h-10 w-10 rounded-full object-cover shadow-sm ring-2 ring-white"
              />
            ))
          }
        </div>
        <span class="bg-border hidden h-8 w-px sm:block"></span>
        <span class="flex items-center gap-1.5">
          <span class="flex text-amber-500">
            {
              [0, 1, 2, 3, 4].map(() => (
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                  <path d="m12 2 2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.8 5.9 20.4l1.4-6.8-5.1-4.6 6.9-.7z" />
                </svg>
              ))
            }
          </span>
          <span class="text-ink text-lg font-bold">{reviews.rating}/5</span>
          <span class="text-muted text-sm">on Google</span>
        </span>
      </div>

      <div class="mt-10">
        <a
          id="hero-rate-cta"
          href={reviews.writeReviewUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-gradient inline-flex min-h-14 items-center justify-center gap-2.5 rounded-full px-8 text-base font-semibold text-white shadow-lg"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true"
            ><path
              fill="#fff"
              d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5a5.6 5.6 0 0 1-2.4 3.6v3h3.9c2.3-2.1 3.5-5.2 3.5-8.8Z"
              opacity="0.9"></path><path
              fill="#fff"
              d="M12 24c3.2 0 6-1.1 8-2.9l-3.9-3c-1.1.7-2.5 1.2-4.1 1.2-3.1 0-5.8-2.1-6.7-5H1.3v3.1A12 12 0 0 0 12 24Z"
              opacity="0.75"></path><path
              fill="#fff"
              d="M5.3 14.3a7.2 7.2 0 0 1 0-4.6V6.6H1.3a12 12 0 0 0 0 10.8l4-3.1Z"
              opacity="0.6"></path><path
              fill="#fff"
              d="M12 4.8c1.8 0 3.3.6 4.6 1.8l3.4-3.4A12 12 0 0 0 1.3 6.6l4 3.1c.9-2.9 3.6-5 6.7-5Z"
            ></path></svg
          >
          Rate us on Google
        </a>
        <p class="text-muted mt-3 text-sm">Takes less than a minute.</p>
      </div>
    </div>
  </section>

  {/* ─── WHAT PEOPLE ARE SAYING ──────────────────────────────────────── */}
  <section class={`${wideWrap} py-4 sm:py-6`}>
    <p
      class="text-muted mx-auto text-center text-[11px] font-semibold tracking-[0.2em] uppercase"
    >
      What Mumbaikars are already saying
    </p>

    <div class="mt-8 grid gap-5 md:grid-cols-3">
      {
        testimonials.map((t, i) => (
          <figure
            class="card card-lift flex flex-col p-7"
            data-reveal
            data-reveal-delay={String(i * 60)}
          >
            <div class="flex items-center justify-between">
              <span
                class="flex text-amber-500"
                aria-label={`${t.rating} out of 5 stars`}
              >
                {Array.from({ length: t.rating }).map(() => (
                  <svg
                    class="h-4 w-4"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="m12 2 2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.8 5.9 20.4l1.4-6.8-5.1-4.6 6.9-.7z" />
                  </svg>
                ))}
              </span>
              <svg
                class="text-ink/[0.08] h-6 w-6"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M7.2 6A5.2 5.2 0 0 0 3 11.2V18h6.4v-6.4H6.2A2.8 2.8 0 0 1 9 8.8V6H7.2Zm10.6 0a5.2 5.2 0 0 0-4.2 5.2V18H20v-6.4h-3.2a2.8 2.8 0 0 1 2.8-2.8V6h-1.8Z" />
              </svg>
            </div>
            <blockquote class="text-body mt-4 flex-1 text-[15px] leading-relaxed">
              “{t.quote}”
            </blockquote>
            <figcaption class="border-border mt-6 flex items-center gap-3 border-t pt-5">
              <Image
                src={reviewAvatars[t.image]}
                alt={t.name}
                width={80}
                height={80}
                class="h-11 w-11 shrink-0 rounded-full object-cover shadow-[0_4px_12px_-4px_rgba(15,23,42,0.35)] ring-2 ring-white"
                loading="lazy"
              />
              <span class="min-w-0">
                <span class="font-display text-ink block text-sm font-semibold">
                  {t.name}
                </span>
                <span class="text-muted flex items-center gap-1 text-xs">
                  <svg
                    class="h-3.5 w-3.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    aria-hidden="true"
                  >
                    <>
                      <path
                        fill="#4285F4"
                        d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1Z"
                      />
                      <path
                        fill="#34A853"
                        d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23Z"
                      />
                      <path
                        fill="#FBBC05"
                        d="M5.84 14.1a6.6 6.6 0 0 1 0-4.2V7.06H2.18a11 11 0 0 0 0 9.88l3.66-2.84Z"
                      />
                      <path
                        fill="#EA4335"
                        d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1A11 11 0 0 0 2.18 7.06l3.66 2.84C6.71 7.3 9.14 5.38 12 5.38Z"
                      />
                    </>
                  </svg>
                  Google review
                </span>
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  {/* ─── HOW IT WORKS ─────────────────────────────────────────────────── */}
  <section class={`${wrap} py-16 sm:py-20`}>
    <p
      class="text-muted mx-auto text-center text-[11px] font-semibold tracking-[0.2em] uppercase"
    >
      How to leave yours
    </p>
    <div class="mt-6 grid gap-4 sm:grid-cols-3">
      {
        steps.map((s, i) => (
          <div class="card p-6" data-reveal data-reveal-delay={String(i * 60)}>
            <span class="icon-tile tile-navy h-11 w-11 text-base font-bold">
              {i + 1}
            </span>
            <h3 class="font-display text-ink mt-4 text-base">{s.title}</h3>
            <p class="text-body mt-1.5 text-sm leading-relaxed">{s.desc}</p>
          </div>
        ))
      }
    </div>

    <div
      class="glass mt-10 flex flex-col items-center gap-4 rounded-2xl p-6 text-center sm:flex-row sm:text-left"
    >
      <span class="icon-tile tile-emerald h-12 w-12 shrink-0">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M12 2 4 5v6c0 5 3.4 8.5 8 10 4.6-1.5 8-5 8-10V5l-8-3Z"
          ></path><path d="m9 12 2 2 4-4"></path></svg
        >
      </span>
      <div>
        <p class="font-display text-ink text-lg">Prefer to talk instead?</p>
        <p class="text-muted text-sm">
          Call or WhatsApp us at{' '}
          <a
            href={`tel:${CONTACT.phoneTel}`}
            class="text-ink font-semibold hover:underline"
            >{CONTACT.phoneDisplay}</a
          > — we're happy to hear your feedback directly.
        </p>
      </div>
    </div>
  </section>

  {
    /* Sticky mobile CTA — appears once the hero button scrolls out of view,
     so the review action stays one tap away without cluttering the page. */
  }
  <div
    id="sticky-review-cta"
    class="fixed inset-x-0 bottom-19 z-40 translate-y-24 px-4 opacity-0 transition-all duration-300 md:hidden"
  >
    <a
      href={reviews.writeReviewUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-gradient mx-auto flex min-h-13 max-w-sm touch-manipulation items-center justify-center gap-2 rounded-full text-sm font-semibold text-white shadow-xl"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" aria-hidden="true"
        ><path
          fill="#fff"
          d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5a5.6 5.6 0 0 1-2.4 3.6v3h3.9c2.3-2.1 3.5-5.2 3.5-8.8Z"
          opacity="0.9"></path><path
          fill="#fff"
          d="M12 24c3.2 0 6-1.1 8-2.9l-3.9-3c-1.1.7-2.5 1.2-4.1 1.2-3.1 0-5.8-2.1-6.7-5H1.3v3.1A12 12 0 0 0 12 24Z"
          opacity="0.75"></path><path
          fill="#fff"
          d="M5.3 14.3a7.2 7.2 0 0 1 0-4.6V6.6H1.3a12 12 0 0 0 0 10.8l4-3.1Z"
          opacity="0.6"></path><path
          fill="#fff"
          d="M12 4.8c1.8 0 3.3.6 4.6 1.8l3.4-3.4A12 12 0 0 0 1.3 6.6l4 3.1c.9-2.9 3.6-5 6.7-5Z"
        ></path></svg
      >
      Rate us on Google
    </a>
  </div>

  <script>
    function initStickyReviewCta() {
      const heroCta = document.getElementById('hero-rate-cta');
      const sticky = document.getElementById('sticky-review-cta');
      if (!heroCta || !sticky) return;

      // Sit exactly on top of the bottom dock (Call/WhatsApp/Directions).
      // Measured at runtime rather than assumed, since its height varies
      // with the device's safe-area inset (iPhone home indicator vs. a
      // regular Android nav bar) and font-size scaling.
      const dock = document.getElementById('mobile-action-bar');
      const positionAboveDock = () => {
        const dockHeight = dock?.getBoundingClientRect().height;
        sticky.style.bottom = dockHeight ? `${dockHeight}px` : '';
      };
      positionAboveDock();
      window.addEventListener('resize', positionAboveDock);
      window.addEventListener('orientationchange', positionAboveDock);

      const show = () => {
        sticky.classList.remove('translate-y-24', 'opacity-0');
        sticky.classList.add('translate-y-0', 'opacity-100');
      };
      const hide = () => {
        sticky.classList.add('translate-y-24', 'opacity-0');
        sticky.classList.remove('translate-y-0', 'opacity-100');
      };

      const observer = new IntersectionObserver(
        ([entry]) => (entry.isIntersecting ? hide() : show()),
        { threshold: 0 }
      );
      observer.observe(heroCta);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initStickyReviewCta);
    } else {
      initStickyReviewCta();
    }
    document.addEventListener('astro:page-load', initStickyReviewCta);
  </script>
</MainLayout>
