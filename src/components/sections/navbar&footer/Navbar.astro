---
import NavLink from '@components/ui/links/NavLink.astro';
import enStrings from '@utils/navigation.ts';
import BrandLogo from '@components/BrandLogo.astro';
import { CONTACT } from '@data/constants';

const strings = enStrings;
const homeUrl = '/';

const primaryCta = strings.navBarLinks.find(link => link.url === '/contact');
const menuLinks = strings.navBarLinks.filter(link => link.url !== '/contact');
---

<div class="sticky top-0 z-50 w-full" data-lenis-prevent>
  {/* Slim contact strip */}
  <div class="hidden bg-[#17255e] text-white/85 md:block">
    <div
      class="mx-auto flex h-9 w-full max-w-[80rem] items-center justify-between px-6 text-[13px] lg:px-8"
    >
      <div class="flex items-center gap-6">
        <span class="inline-flex items-center gap-2">
          <svg
            class="h-4 w-4 text-red-400"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"
            ></path><circle cx="12" cy="10" r="3"></circle></svg
          >
          {CONTACT.area}, {CONTACT.city}
        </span>
        <span class="hidden items-center gap-2 lg:inline-flex">
          <svg
            class="h-4 w-4 text-white/60"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"
            ></path></svg
          >
          Mon–Sat · 9:00 AM – 10:00 PM
        </span>
      </div>
      <div class="flex items-center gap-5">
        <a
          href={`mailto:${CONTACT.email}`}
          class="hidden items-center gap-2 transition-colors hover:text-white lg:inline-flex"
        >
          <svg
            class="h-4 w-4 text-white/60"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><rect x="3" y="5" width="18" height="14" rx="2"></rect><path
              d="m3 7 9 6 9-6"></path></svg
          >
          {CONTACT.email}
        </a>
        <span class="hidden h-4 w-px bg-white/20 lg:block"></span>
        <a
          href={`tel:${CONTACT.phoneTel}`}
          class="inline-flex items-center gap-2 font-semibold text-white transition-colors hover:text-red-300"
        >
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.6a2 2 0 0 1-.5 2.1L8.1 9.5a16 16 0 0 0 6 6l1.1-1.1a2 2 0 0 1 2.1-.5c.8.3 1.7.5 2.6.6a2 2 0 0 1 1.7 2Z"
            ></path></svg
          >
          {CONTACT.phoneDisplay}
        </a>
      </div>
    </div>
  </div>

  {/* Main navigation bar — clean full-width bar */}
  <header class="border-border w-full border-b bg-white/90 backdrop-blur-lg">
    <div class="mx-auto w-full max-w-[80rem] px-4 sm:px-6 lg:px-8">
      <nav
        class="flex h-16 items-center justify-between gap-4 md:grid md:grid-cols-[auto_1fr_auto] lg:h-[4.5rem]"
        aria-label="Global"
      >
        <a
          class="flex min-h-11 flex-none items-center gap-3 rounded-lg outline-hidden focus-visible:ring-3 focus-visible:ring-blue-300"
          href={homeUrl}
          aria-label="MA Infotech home"
        >
          <BrandLogo class="h-9 w-auto object-contain sm:h-10 lg:h-11" />
          <span
            class="font-display text-navy text-center text-base font-bold lg:text-lg"
          >
            एम.ए. इन्फोटेक
          </span>
        </a>

        {/* Desktop links — centered */}
        <div class="hidden items-center justify-center gap-1 md:flex lg:gap-2">
          {menuLinks.map(link => <NavLink url={link.url} name={link.name} />)}
        </div>

        <div class="flex items-center justify-end gap-2 sm:gap-3">
          {
            primaryCta && (
              <a
                href={primaryCta.url}
                data-astro-prefetch
                class="btn-gradient hidden min-h-11 items-center justify-center gap-2 rounded-full px-6 text-sm font-semibold text-white sm:inline-flex"
              >
                <svg
                  class="h-4 w-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.6a2 2 0 0 1-.5 2.1L8.1 9.5a16 16 0 0 0 6 6l1.1-1.1a2 2 0 0 1 2.1-.5c.8.3 1.7.5 2.6.6a2 2 0 0 1 1.7 2Z" />
                </svg>
                Book a service
              </a>
            )
          }

          <button
            type="button"
            id="mobile-nav-toggle"
            class="group border-border text-ink active:bg-surface inline-flex min-h-11 min-w-11 items-center justify-center rounded-xl border bg-white transition-colors duration-200 md:hidden"
            aria-controls="mobile-nav-menu"
            aria-expanded="false"
            aria-label="Open menu"
          >
            <svg
              data-mobile-nav-icon="menu"
              class="h-5 w-5 shrink-0 group-aria-expanded:hidden"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="4" x2="20" y1="7" y2="7"></line>
              <line x1="4" x2="20" y1="12" y2="12"></line>
              <line x1="4" x2="20" y1="17" y2="17"></line>
            </svg>
            <svg
              data-mobile-nav-icon="close"
              class="hidden h-5 w-5 shrink-0 group-aria-expanded:block"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M18 6 6 18"></path>
              <path d="m6 6 12 12"></path>
            </svg>
          </button>
        </div>
      </nav>
    </div>
  </header>
</div>

{/* Mobile full-screen menu */}
<div
  id="mobile-nav-menu"
  class="bg-canvas pointer-events-none invisible fixed inset-0 z-[100] flex flex-col opacity-0 transition-[opacity,visibility] duration-200 ease-out md:hidden"
  aria-hidden="true"
  inert
  data-lenis-prevent
>
  <div
    class="border-border flex shrink-0 items-center justify-between gap-3 border-b bg-white/95 px-4 pt-[max(0.75rem,env(safe-area-inset-top))] pb-3 backdrop-blur-md"
  >
    <a
      class="flex min-h-11 flex-none items-center rounded-lg outline-hidden focus-visible:ring-3 focus-visible:ring-blue-300"
      href={homeUrl}
      aria-label="MA Infotech home"
    >
      <BrandLogo class="h-10 w-auto object-contain" />
    </a>
    <button
      type="button"
      id="mobile-nav-close"
      class="border-border text-ink active:bg-surface inline-flex min-h-11 min-w-11 items-center justify-center rounded-xl border bg-white transition-colors duration-200"
      aria-label="Close menu"
    >
      <svg
        class="h-5 w-5 shrink-0"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M18 6 6 18"></path>
        <path d="m6 6 12 12"></path>
      </svg>
    </button>
  </div>

  <nav
    class="flex min-h-0 flex-1 flex-col overflow-y-auto overscroll-contain px-5 py-6"
    aria-label="Mobile"
  >
    <p
      class="text-muted mx-auto w-full max-w-md px-1 text-[11px] font-semibold tracking-[0.2em] uppercase"
    >
      Menu
    </p>
    <ul class="mx-auto mt-3 flex w-full max-w-md flex-col gap-2">
      {
        menuLinks.map(link => (
          <li>
            <a
              href={link.url}
              data-nav-url={link.url}
              data-astro-prefetch
              class="mobile-nav-link border-border bg-surface-soft text-ink active:bg-surface flex min-h-14 items-center justify-between rounded-2xl border px-5 text-lg font-semibold transition-colors duration-200"
            >
              {link.name}
              <svg
                class="text-muted h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M9 6l6 6-6 6" />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>

    <div
      class="mx-auto mt-auto w-full max-w-md space-y-3 pt-8 pb-[max(1.5rem,env(safe-area-inset-bottom))]"
    >
      <a
        href={CONTACT.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-14 w-full items-center justify-center gap-2.5 rounded-2xl bg-[#25D366] px-5 text-base font-semibold text-white shadow-sm"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"
          ><path
            d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2Zm5.3 14.2c-.2.6-1.2 1.1-1.7 1.2-.5.1-1 .1-1.6-.1-.4-.1-.9-.3-1.5-.5-2.6-1.1-4.3-3.8-4.4-4-.1-.2-1-1.4-1-2.6s.6-1.8.9-2.1c.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.7 1.7c.1.1.1.3 0 .5l-.3.4-.3.4c-.1.1-.3.3-.1.5.1.3.6 1 1.3 1.6.9.8 1.6 1 1.9 1.2.2.1.4.1.5-.1l.6-.7c.2-.2.3-.2.6-.1l1.6.8c.2.1.4.2.5.3.1.2.1.6-.1 1.1Z"
          ></path></svg
        >
        Chat on WhatsApp
      </a>
      <div class="grid grid-cols-2 gap-3">
        <a
          href={`tel:${CONTACT.phoneTel}`}
          class="border-border bg-surface-soft text-ink inline-flex min-h-12 items-center justify-center gap-2 rounded-2xl border px-4 text-sm font-semibold"
        >
          <svg
            class="h-4 w-4 text-blue-600"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.6a2 2 0 0 1-.5 2.1L8.1 9.5a16 16 0 0 0 6 6l1.1-1.1a2 2 0 0 1 2.1-.5c.8.3 1.7.5 2.6.6a2 2 0 0 1 1.7 2Z"
            ></path></svg
          >
          Call
        </a>
        <a
          href={primaryCta?.url ?? '/contact'}
          data-nav-url="/contact"
          data-astro-prefetch
          class="border-border bg-surface-soft text-ink inline-flex min-h-12 items-center justify-center gap-2 rounded-2xl border px-4 text-sm font-semibold"
        >
          Book
        </a>
      </div>
    </div>
  </nav>
</div>

<style>
  #mobile-nav-menu[data-open='true'] {
    pointer-events: auto;
    visibility: visible;
    opacity: 1;
  }

  #mobile-nav-menu[data-open='true'] .mobile-nav-link {
    animation: mobile-nav-item 320ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  #mobile-nav-menu[data-open='true'] li:nth-child(1) .mobile-nav-link {
    animation-delay: 40ms;
  }
  #mobile-nav-menu[data-open='true'] li:nth-child(2) .mobile-nav-link {
    animation-delay: 70ms;
  }
  #mobile-nav-menu[data-open='true'] li:nth-child(3) .mobile-nav-link {
    animation-delay: 100ms;
  }
  #mobile-nav-menu[data-open='true'] li:nth-child(4) .mobile-nav-link {
    animation-delay: 130ms;
  }

  @keyframes mobile-nav-item {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #mobile-nav-menu[data-open='true'] .mobile-nav-link {
      animation: none;
    }
  }
</style>

<script>
  const updateActiveNavLink = () => {
    const currentPath = window.location.pathname;
    const navLinks = document.querySelectorAll('[data-nav-url]');

    navLinks.forEach(link => {
      const href = link.getAttribute('data-nav-url');
      if (!href) return;

      const isActive =
        href === '/'
          ? currentPath === '/'
          : currentPath === href || currentPath.startsWith(`${href}/`);

      link.classList.remove('bg-surface', 'text-ink', 'border-border');

      if (link.classList.contains('mobile-nav-link')) {
        if (isActive) {
          link.classList.add('bg-surface', 'text-ink', 'border-border');
          link.setAttribute('aria-current', 'page');
        } else {
          link.removeAttribute('aria-current');
        }
        return;
      }

      link.classList.remove('bg-surface', 'text-ink');
      link.classList.add('text-muted');

      if (isActive) {
        link.classList.remove('text-muted');
        link.classList.add('bg-surface', 'text-ink');
        link.setAttribute('aria-current', 'page');
      } else {
        link.removeAttribute('aria-current');
      }
    });
  };

  document.addEventListener('DOMContentLoaded', updateActiveNavLink);
  document.addEventListener('astro:page-load', updateActiveNavLink);
</script>
