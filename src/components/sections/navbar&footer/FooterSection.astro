---
import Icon from '@components/ui/icons/Icon.astro';
import BrandLogo from '@components/BrandLogo.astro';
import enStrings from '@utils/navigation.ts';
import { CONTACT } from '@data/constants';

const strings = enStrings;
const currentYear = new Date().getFullYear();
const reviews = CONTACT.googleReviews;
const exploreLinks = strings.footerLinks[0]?.links ?? strings.navBarLinks;
// The /contact page already shows the address + map, so drop the footer's
// duplicate "Visit us" map block there.
const isContactPage = Astro.url.pathname.replace(/\/$/, '') === '/contact';
const footerGridClass = isContactPage
  ? 'grid grid-cols-1 gap-y-10 sm:grid-cols-2 sm:gap-x-10 lg:grid-cols-[1.6fr_1fr_1.2fr] lg:gap-12'
  : 'grid grid-cols-1 gap-y-10 sm:grid-cols-2 sm:gap-x-10 lg:grid-cols-[1.5fr_0.8fr_1fr_1.35fr] lg:gap-12';
---

<footer
  class="border-border bg-surface-soft text-body relative w-full overflow-hidden border-t"
>
  <div
    class="bg-brand-gradient absolute inset-x-0 top-0 h-1"
    aria-hidden="true"
  >
  </div>
  {/* Decorative backdrop */}
  <div
    class="grid-pattern pointer-events-none absolute inset-x-0 top-0 h-72 opacity-70"
    aria-hidden="true"
  >
  </div>
  <div
    class="brand-glow brand-glow--navy -top-24 -left-24 h-80 w-80 opacity-70"
    aria-hidden="true"
  >
  </div>
  <div
    class="brand-glow brand-glow--red -top-16 right-0 h-72 w-72 opacity-60"
    aria-hidden="true"
  >
  </div>

  <div
    class="relative mx-auto w-full max-w-[80rem] px-5 pt-14 pb-[max(1.5rem,env(safe-area-inset-bottom))] sm:px-6 sm:pt-16 lg:px-8 lg:pt-20"
  >
    <div class={footerGridClass}>
      {/* Brand */}
      <div class="sm:col-span-2 lg:col-span-1">
        <a
          href="/"
          class="inline-block outline-hidden focus-visible:ring-3 focus-visible:ring-blue-300"
          aria-label="MA Infotech home"
        >
          <BrandLogo class="h-11 w-auto object-contain lg:h-12" />
        </a>
        <p
          class="font-display text-gradient mt-5 text-xl font-bold tracking-tight"
        >
          MA INFOTECH
        </p>
        <p class="text-body mt-2 max-w-xs text-[15px] leading-relaxed">
          Computer sales, repairs, networking &amp; CCTV — trusted across
          Mumbai.
        </p>

        {
          /* Google rating — shown here in the brand column on desktop (moves to the bottom section on mobile) */
        }
        <a
          href={reviews.url}
          target="_blank"
          rel="noopener noreferrer"
          class="card card-lift mt-6 hidden items-center gap-3 p-2.5 pr-4 sm:inline-flex"
          aria-label={`Rated ${reviews.rating} out of 5 on Google`}
        >
          <span
            class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-white shadow-sm"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true"
              ><path
                fill="#4285F4"
                d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5a5.6 5.6 0 0 1-2.4 3.6v3h3.9c2.3-2.1 3.5-5.2 3.5-8.8Z"
              ></path><path
                fill="#34A853"
                d="M12 24c3.2 0 6-1.1 8-2.9l-3.9-3c-1.1.7-2.5 1.2-4.1 1.2-3.1 0-5.8-2.1-6.7-5H1.3v3.1A12 12 0 0 0 12 24Z"
              ></path><path
                fill="#FBBC05"
                d="M5.3 14.3a7.2 7.2 0 0 1 0-4.6V6.6H1.3a12 12 0 0 0 0 10.8l4-3.1Z"
              ></path><path
                fill="#EA4335"
                d="M12 4.8c1.8 0 3.3.6 4.6 1.8l3.4-3.4A12 12 0 0 0 1.3 6.6l4 3.1c.9-2.9 3.6-5 6.7-5Z"
              ></path></svg
            >
          </span>
          <span>
            <span class="flex items-center gap-1.5">
              <span class="font-display text-ink text-base font-bold"
                >{reviews.rating}</span
              >
              <span class="flex text-amber-500">
                {
                  [0, 1, 2, 3, 4].map(() => (
                    <svg
                      class="h-3.5 w-3.5"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                    >
                      <path d="m12 2 2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.8 5.9 20.4l1.4-6.8-5.1-4.6 6.9-.7z" />
                    </svg>
                  ))
                }
              </span>
            </span>
            <span class="text-muted mt-0.5 block text-xs font-medium"
              >Rated on Google</span
            >
          </span>
        </a>

        <button
          type="button"
          data-pwa-install
          class="border-navy text-navy mt-6 hidden min-h-11 items-center gap-2 rounded-full border bg-white px-5 text-sm font-semibold transition-colors hover:bg-blue-50"
        >
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M12 3v12m0 0 4-4m-4 4-4-4"></path><path d="M5 21h14"
            ></path></svg
          >
          Install app
        </button>
      </div>

      {/* Explore */}
      <div>
        <h3 class="text-navy text-xs font-semibold tracking-[0.2em] uppercase">
          Explore
        </h3>
        <ul
          class="mt-5 grid grid-cols-2 gap-x-4 gap-y-1 sm:flex sm:flex-col sm:gap-1"
        >
          {
            exploreLinks.map(link => (
              <li>
                <a
                  href={link.url}
                  class="group text-body inline-flex min-h-10 items-center gap-2.5 text-[15px] font-medium transition-colors hover:text-blue-700"
                >
                  <span class="bg-border h-1.5 w-1.5 rounded-full transition-colors group-hover:bg-red-500" />
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {/* Reach us */}
      <div>
        <h3 class="text-navy text-xs font-semibold tracking-[0.2em] uppercase">
          Reach us
        </h3>
        <div class="mt-5 space-y-3">
          <a
            href={CONTACT.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-3"
          >
            <span
              class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"
                ><path
                  d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2Zm5.3 14.2c-.2.6-1.2 1.1-1.7 1.2-.5.1-1 .1-1.6-.1-.4-.1-.9-.3-1.5-.5-2.6-1.1-4.3-3.8-4.4-4-.1-.2-1-1.4-1-2.6s.6-1.8.9-2.1c.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.7 1.7c.1.1.1.3 0 .5l-.3.4-.3.4c-.1.1-.3.3-.1.5.1.3.6 1 1.3 1.6.9.8 1.6 1 1.9 1.2.2.1.4.1.5-.1l.6-.7c.2-.2.3-.2.6-.1l1.6.8c.2.1.4.2.5.3.1.2.1.6-.1 1.1Z"
                ></path></svg
              >
            </span>
            <span
              class="text-ink text-[15px] font-medium group-hover:text-emerald-700"
              >WhatsApp</span
            >
          </a>
          <a
            href={`tel:${CONTACT.phoneTel}`}
            class="group flex items-center gap-3"
          >
            <span
              class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-600"
            >
              <svg
                class="h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path
                  d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.6a2 2 0 0 1-.5 2.1L8.1 9.5a16 16 0 0 0 6 6l1.1-1.1a2 2 0 0 1 2.1-.5c.8.3 1.7.5 2.6.6a2 2 0 0 1 1.7 2Z"
                ></path></svg
              >
            </span>
            <span
              class="text-ink text-[15px] font-medium break-all group-hover:text-blue-700"
              >{CONTACT.phoneDisplay}</span
            >
          </a>
          <a
            href={`mailto:${CONTACT.email}`}
            class="group flex items-center gap-3"
          >
            <span
              class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-red-50 text-red-600"
            >
              <svg
                class="h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><rect x="3" y="5" width="18" height="14" rx="2"></rect><path
                  d="m3 7 9 6 9-6"></path></svg
              >
            </span>
            <span
              class="text-ink text-[15px] font-medium break-all group-hover:text-red-700"
              >{CONTACT.email}</span
            >
          </a>
        </div>

        {/* Hours — below Reach us */}
        <div class="border-border mt-6 border-t pt-5">
          <p class="text-navy text-xs font-semibold tracking-[0.2em] uppercase">
            Hours
          </p>
          <div class="mt-2.5 space-y-2">
            {
              CONTACT.hours.map(row =>
                row.time === 'Closed' ? (
                  <p class="text-sm">
                    <>
                      <span class="text-body">{row.day}</span>
                      <span class="text-ink ml-1.5 font-semibold">
                        — Closed
                      </span>
                    </>
                  </p>
                ) : (
                  <p class="text-sm">
                    <span class="text-body block">{row.day}</span>
                    <span class="text-ink block font-semibold">{row.time}</span>
                  </p>
                )
              )
            }
          </div>
        </div>
      </div>

      {
        /* Visit us — address above the map (hidden on /contact to avoid a duplicate map) */
      }
      {
        !isContactPage && (
          <div class="sm:col-span-2 lg:col-span-1">
            <h3 class="text-navy text-xs font-semibold tracking-[0.2em] uppercase">
              Visit us
            </h3>
            <p class="text-body mt-5 flex items-start gap-2.5 text-[15px] leading-relaxed">
              <svg
                class="mt-0.5 h-4 w-4 shrink-0 text-blue-600"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <>
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                  <circle cx="12" cy="10" r="3" />
                </>
              </svg>
              {CONTACT.addressFull}
            </p>
            <div class="card group relative mt-4 overflow-hidden">
              <iframe
                class="h-52 w-full"
                src={CONTACT.mapEmbedUrl}
                style="border:0;"
                allowfullscreen
                loading="lazy"
                referrerpolicy="strict-origin-when-cross-origin"
                title="MA Infotech location map"
              />
              <a
                href={CONTACT.mapDirectionsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="glass text-navy absolute bottom-3 left-3 inline-flex min-h-10 items-center gap-2 rounded-full px-4 text-sm font-semibold shadow-lg transition-transform duration-200 hover:-translate-y-0.5"
                aria-label="Get directions to MA Infotech on Google Maps"
              >
                <svg
                  class="h-4 w-4 text-red-500"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <>
                    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                    <circle cx="12" cy="10" r="3" />
                  </>
                </svg>
                Directions
              </a>
            </div>
          </div>
        )
      }
    </div>

    {/* Bottom bar */}
    <div class="border-border mt-12 border-t pt-7">
      <div
        class="flex flex-col items-center gap-7 sm:flex-row sm:items-center sm:justify-between sm:gap-6"
      >
        {/* Left: Follow us + Google rating */}
        <div
          class="flex flex-col items-center gap-5 sm:flex-row sm:items-center sm:gap-6"
        >
          {/* Follow us */}
          <div class="flex flex-col items-center gap-2.5 sm:items-start">
            <p
              class="text-navy text-xs font-semibold tracking-[0.2em] uppercase"
            >
              Follow us
            </p>
            <div class="flex items-center gap-3">
              <a
                href={strings.socialLinks.facebook}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Facebook"
                class="social-btn social-fb"><Icon name="facebookFooter" /></a
              >
              <a
                href={strings.socialLinks.instagram}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Instagram"
                class="social-btn social-ig"><Icon name="instagramFooter" /></a
              >
              <a
                href={CONTACT.whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="WhatsApp"
                class="social-btn social-wa"
              >
                <svg
                  class="h-5 w-5"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                  ><path
                    d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2Zm5.3 14.2c-.2.6-1.2 1.1-1.7 1.2-.5.1-1 .1-1.6-.1-.4-.1-.9-.3-1.5-.5-2.6-1.1-4.3-3.8-4.4-4-.1-.2-1-1.4-1-2.6s.6-1.8.9-2.1c.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.7 1.7c.1.1.1.3 0 .5l-.3.4-.3.4c-.1.1-.3.3-.1.5.1.3.6 1 1.3 1.6.9.8 1.6 1 1.9 1.2.2.1.4.1.5-.1l.6-.7c.2-.2.3-.2.6-.1l1.6.8c.2.1.4.2.5.3.1.2.1.6-.1 1.1Z"
                  ></path></svg
                >
              </a>
            </div>
          </div>

          {
            /* Google rating badge — mobile only; desktop shows it in the brand column */
          }
          <a
            href={reviews.url}
            target="_blank"
            rel="noopener noreferrer"
            class="card card-lift inline-flex items-center gap-3 p-2.5 pr-4 sm:hidden"
            aria-label={`Rated ${reviews.rating} out of 5 on Google`}
          >
            <span
              class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-white shadow-sm"
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true"
                ><path
                  fill="#4285F4"
                  d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5a5.6 5.6 0 0 1-2.4 3.6v3h3.9c2.3-2.1 3.5-5.2 3.5-8.8Z"
                ></path><path
                  fill="#34A853"
                  d="M12 24c3.2 0 6-1.1 8-2.9l-3.9-3c-1.1.7-2.5 1.2-4.1 1.2-3.1 0-5.8-2.1-6.7-5H1.3v3.1A12 12 0 0 0 12 24Z"
                ></path><path
                  fill="#FBBC05"
                  d="M5.3 14.3a7.2 7.2 0 0 1 0-4.6V6.6H1.3a12 12 0 0 0 0 10.8l4-3.1Z"
                ></path><path
                  fill="#EA4335"
                  d="M12 4.8c1.8 0 3.3.6 4.6 1.8l3.4-3.4A12 12 0 0 0 1.3 6.6l4 3.1c.9-2.9 3.6-5 6.7-5Z"
                ></path></svg
              >
            </span>
            <span>
              <span class="flex items-center gap-1.5">
                <span class="font-display text-ink text-base font-bold"
                  >{reviews.rating}</span
                >
                <span class="flex text-amber-500">
                  {
                    [0, 1, 2, 3, 4].map(() => (
                      <svg
                        class="h-3.5 w-3.5"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                      >
                        <path d="m12 2 2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.8 5.9 20.4l1.4-6.8-5.1-4.6 6.9-.7z" />
                      </svg>
                    ))
                  }
                </span>
              </span>
              <span class="text-muted mt-0.5 block text-xs font-medium"
                >Rated on Google</span
              >
            </span>
          </a>
        </div>

        {/* Right: copyright above crafted-by */}
        <div class="text-center sm:text-right">
          <p class="text-muted text-sm">
            © {currentYear} MA Infotech. All rights reserved.
          </p>
          <p class="text-muted mt-1 text-sm">
            Crafted by
            {` `}
            <a
              class="text-body font-medium transition-colors hover:text-blue-700"
              href="https://eightharsh.com/"
              target="_blank"
              rel="noopener noreferrer">eightharsh</a
            >.
          </p>
        </div>
      </div>
    </div>
  </div>
</footer>
