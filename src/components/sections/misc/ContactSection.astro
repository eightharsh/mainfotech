---
import AuthBtn from '@components/ui/buttons/AuthBtn.astro';
import TextInput from '@components/ui/forms/input/TextInput.astro';
import EmailContactInput from '@components/ui/forms/input/EmailContactInput.astro';
import PhoneInput from '@components/ui/forms/input/PhoneInput.astro';
import TextAreaInput from '@components/ui/forms/input/TextAreaInput.astro';
import { SITE, CONTACT } from '@data/constants';

const contactSource = `${SITE.url}/contact`;
const wrap = 'mx-auto w-full max-w-[80rem] px-4 sm:px-6 lg:px-8';

const copy = {
  successMessage:
    'Thank you for contacting MA Infotech. Our team will get in touch with you shortly.',
  errorMessage:
    'Sorry, we could not send your message right now. Please try again.',
  sendingMessage: 'Sending your message…',
};

const inquiryOptions = [
  { value: 'repair', label: 'Repair / Service' },
  { value: 'sales', label: 'Buy a product' },
  { value: 'custom-pc', label: 'Custom PC build' },
  { value: 'networking', label: 'Networking / Wi-Fi' },
  { value: 'cctv', label: 'CCTV / Security' },
  { value: 'amc', label: 'AMC / IT support' },
  { value: 'other', label: 'Other' },
];

const fieldClass =
  'block min-h-12 w-full rounded-xl border border-border bg-canvas px-4 py-3 text-base text-body placeholder:text-muted focus:border-blue-500 focus:ring-3 focus:ring-blue-100 focus:outline-hidden sm:min-h-11 sm:text-sm';
---

{/* Hero */}
<section class="mesh-hero relative overflow-hidden">
  <div
    class="grid-pattern pointer-events-none absolute inset-0"
    aria-hidden="true"
  >
  </div>
  <div
    class="brand-glow brand-glow--navy -top-20 -left-20 h-80 w-80"
    aria-hidden="true"
  >
  </div>
  <div
    class="brand-glow brand-glow--emerald top-8 -right-10 h-72 w-72"
    aria-hidden="true"
  >
  </div>
  <div class={`${wrap} relative py-16 text-center sm:py-20`}>
    <span class="eyebrow mx-auto" data-reveal
      ><span class="h-1.5 w-1.5 rounded-full bg-blue-600"></span>Get in touch</span
    >
    <h1
      class="font-display text-ink mx-auto mt-6 max-w-3xl text-4xl leading-[1.05] text-balance sm:text-5xl lg:text-6xl"
      data-reveal
    >
      Let's get you <span class="text-gradient">sorted</span>
    </h1>
    <p class="text-body mx-auto mt-6 max-w-xl text-lg" data-reveal>
      A repair, a product enquiry, or a project in mind? Send a message and our
      team will reply quickly — or call / WhatsApp us now.
    </p>
  </div>
</section>

{/* Quick actions */}
<section class={`${wrap} -mt-6 relative z-10`}>
  <div class="grid gap-4 sm:grid-cols-3" data-reveal>
    <a
      href={`tel:${CONTACT.phoneTel}`}
      class="card card-lift flex items-center gap-3 p-5"
    >
      <span class="icon-tile tile-navy h-11 w-11"
        ><svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.9"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path
            d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.6a2 2 0 0 1-.5 2.1L8.1 9.5a16 16 0 0 0 6 6l1.1-1.1a2 2 0 0 1 2.1-.5c.8.3 1.7.5 2.6.6a2 2 0 0 1 1.7 2Z"
          ></path></svg
        ></span
      >
      <div>
        <p class="text-muted text-xs font-medium uppercase">Call</p><p
          class="text-ink text-sm font-bold"
        >
          {CONTACT.phoneDisplay}
        </p>
      </div>
    </a>
    <a
      href={CONTACT.whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="card card-lift flex items-center gap-3 p-5"
    >
      <span class="icon-tile tile-emerald h-11 w-11"
        ><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"
          ><path
            d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2Zm5.3 14.2c-.2.6-1.2 1.1-1.7 1.2-.5.1-1 .1-1.6-.1-.4-.1-.9-.3-1.5-.5-2.6-1.1-4.3-3.8-4.4-4-.1-.2-1-1.4-1-2.6s.6-1.8.9-2.1c.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.7 1.7c.1.1.1.3 0 .5l-.3.4-.3.4c-.1.1-.3.3-.1.5.1.3.6 1 1.3 1.6.9.8 1.6 1 1.9 1.2.2.1.4.1.5-.1l.6-.7c.2-.2.3-.2.6-.1l1.6.8c.2.1.4.2.5.3.1.2.1.6-.1 1.1Z"
          ></path></svg
        ></span
      >
      <div>
        <p class="text-muted text-xs font-medium uppercase">WhatsApp</p><p
          class="text-ink text-sm font-bold"
        >
          Message us
        </p>
      </div>
    </a>
    <a
      href={`mailto:${CONTACT.email}`}
      class="card card-lift flex items-center gap-3 p-5"
    >
      <span class="icon-tile tile-red h-11 w-11"
        ><svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.9"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><rect x="3" y="5" width="18" height="14" rx="2"></rect><path
            d="m3 7 9 6 9-6"></path></svg
        ></span
      >
      <div>
        <p class="text-muted text-xs font-medium uppercase">Email</p><p
          class="text-ink truncate text-sm font-bold"
        >
          {CONTACT.email}
        </p>
      </div>
    </a>
  </div>
</section>

{/* Form + info */}
<section class={`${wrap} py-16 sm:py-20`}>
  <div class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:gap-10">
    {/* Form */}
    <div class="card p-7 sm:p-9" data-reveal>
      <h2 class="font-display text-ink text-2xl sm:text-3xl">Send a message</h2>
      <p class="text-body mt-2 text-[15px] leading-relaxed">
        Tell us your device, the issue or product, and your area in Mumbai — it
        helps us respond faster.
      </p>

      <form
        id="contact-form"
        data-contact-form
        action="/api/contact"
        method="post"
        class="mt-7 flex flex-col gap-4 sm:gap-5"
        data-success-message={copy.successMessage}
        data-error-message={copy.errorMessage}
        data-sending-message={copy.sendingMessage}
      >
        <input type="hidden" name="from_name" value="MA Infotech Website" />
        <input type="hidden" name="source" value={contactSource} />
        <input
          type="checkbox"
          name="botcheck"
          class="hidden"
          style="display:none;"
          tabindex="-1"
          autocomplete="off"
        />

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <TextInput
            id="hs-firstname-contacts"
            label="First Name"
            name="firstName"
          />
          <TextInput
            id="hs-lastname-contacts"
            label="Last Name"
            name="lastName"
            required={false}
          />
        </div>

        <EmailContactInput id="hs-email-contacts" />

        <PhoneInput
          id="hs-phone-number"
          countryId="hs-phone-country-code"
          label="Phone Number"
          countryLabel="Country Code"
          defaultCountryCode="IN"
          minDigits={10}
          maxDigits={10}
        />

        <div>
          <label for="hs-inquiry-type" class="sr-only">Inquiry type</label>
          <select
            id="hs-inquiry-type"
            name="inquiryType"
            required
            class={fieldClass}
          >
            <option value="" disabled selected>How can we help?</option>
            {
              inquiryOptions.map(opt => (
                <option value={opt.value}>{opt.label}</option>
              ))
            }
          </select>
        </div>

        <TextAreaInput
          id="hs-about-contacts"
          label="Message"
          name="message"
          rows={4}
          maxlength={500}
          showCharCount={true}
          class="min-h-[6.5rem] resize-y sm:min-h-[8rem]"
        />

        <p
          class="hidden min-h-[1.25rem] text-sm leading-6"
          data-form-status
          aria-live="polite"
        >
        </p>

        <div class="pt-1"><AuthBtn title="Send Message" /></div>
      </form>
    </div>

    {/* Info rail */}
    <aside class="space-y-6" data-reveal data-reveal-delay="100">
      {/* Address + hours card */}
      <div class="card overflow-hidden">
        <div class="bg-brand-gradient relative overflow-hidden p-6">
          <div
            class="grid-pattern absolute inset-0 opacity-30"
            aria-hidden="true"
          >
          </div>
          <div class="relative flex items-center gap-3">
            <span class="icon-tile h-11 w-11 bg-white/20"
              ><svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.9"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"
                ></path><circle cx="12" cy="10" r="3"></circle></svg
              ></span
            >
            <div>
              <p class="text-xs font-medium text-white/75 uppercase">
                Visit the shop
              </p><p class="font-display text-lg text-white">MA Infotech</p>
            </div>
          </div>
        </div>
        <div class="p-6">
          <p class="text-body text-sm leading-relaxed">{CONTACT.addressFull}</p>
          <a
            href={CONTACT.mapDirectionsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-blue-600 hover:underline"
            >Get directions →</a
          >

          <div class="border-border mt-6 border-t pt-5">
            <p
              class="text-navy text-xs font-semibold tracking-[0.14em] uppercase"
            >
              Business hours
            </p>
            <dl class="mt-3 space-y-2">
              {
                CONTACT.hours.map(row => (
                  <div class="flex items-center justify-between text-sm">
                    <dt class="text-body">{row.day}</dt>
                    <dd class="text-ink font-semibold">{row.time}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>
      </div>

      {/* Map */}
      <div class="card overflow-hidden">
        <iframe
          class="h-56 w-full"
          src={CONTACT.mapEmbedUrl}
          style="border:0;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          title="MA Infotech location map"></iframe>
      </div>
    </aside>
  </div>
</section>
