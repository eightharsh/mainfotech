---
// Destructure the properties from Astro.props
const { title, url } = Astro.props;

// Define TypeScript interface for the properties
interface Props {
  title?: string;
  url?: string;
}
// Define CSS classes for the hyperlink button
const baseClasses =
  'inline-flex items-center justify-center gap-x-2 rounded-lg px-5 py-3 text-center text-sm font-semibold text-ink outline-hidden ring-neutral-300 focus-visible:ring-3 transition-colors duration-200';
const borderClasses = 'border border-border';
const bgColorClasses = 'bg-canvas';
const hoverClasses = 'hover:border-neutral-400 hover:bg-surface active:bg-surface';
const disableClasses = 'disabled:pointer-events-none disabled:opacity-50';
const fontSizeClasses = '2xl:text-base';
const ringClasses = '';

const darkClasses = '';
---

{/* Styled hyperlink */}
<a
  class={`${baseClasses} ${borderClasses} ${bgColorClasses} ${hoverClasses} ${disableClasses} ${fontSizeClasses} ${ringClasses} ${darkClasses}`}
  href={url}
>
  {title}
</a>
