---
import Icon from '@components/ui/icons/Icon.astro';

// White card with hairline border — compact feature highlight.
const { icon, title, description, accent = 'blue' } = Astro.props;

interface Props {
  icon?: string;
  title: string;
  description: string;
  accent?: 'blue' | 'purple' | 'cyan' | 'emerald' | 'amber' | 'red';
}

const accents = {
  blue: { tile: 'bg-blue-50 text-blue-600', hover: 'hover:border-blue-200' },
  purple: {
    tile: 'bg-purple-50 text-purple-600',
    hover: 'hover:border-purple-200',
  },
  cyan: { tile: 'bg-cyan-50 text-cyan-600', hover: 'hover:border-cyan-200' },
  emerald: {
    tile: 'bg-emerald-50 text-emerald-600',
    hover: 'hover:border-emerald-200',
  },
  amber: { tile: 'bg-amber-50 text-amber-600', hover: 'hover:border-amber-200' },
  red: { tile: 'bg-red-50 text-red-600', hover: 'hover:border-red-200' },
};
const a = accents[accent] ?? accents.blue;
---

<article
  class:list={[
    'flex h-full flex-col rounded-xl border border-border bg-canvas p-6 transition-colors duration-200',
    a.hover,
  ]}
>
  {
    icon && (
      <span
        class:list={[
          'inline-flex h-10 w-10 items-center justify-center rounded-lg',
          a.tile,
        ]}
      >
        <Icon name={icon} />
      </span>
    )
  }
  <h3 class="mt-4 text-base font-semibold text-ink">{title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-body">{description}</p>
</article>
