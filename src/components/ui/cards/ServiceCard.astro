---
import Icon from '@components/ui/icons/Icon.astro';

// Light card with a colored icon tile, title, description and optional bullets.
const { icon, title, description, items = [], accent = 'blue' } = Astro.props;

interface Props {
  icon?: string;
  title: string;
  description: string;
  items?: string[];
  accent?: 'blue' | 'purple' | 'cyan' | 'emerald' | 'amber' | 'red';
}

// Literal class strings so Tailwind keeps them in the build.
const accents = {
  blue: { tile: 'bg-blue-50 text-blue-600', hover: 'hover:border-blue-200' },
  purple: {
    tile: 'bg-purple-50 text-purple-600',
    hover: 'hover:border-purple-200',
  },
  cyan: { tile: 'bg-cyan-50 text-cyan-600', hover: 'hover:border-cyan-200' },
  emerald: {
    tile: 'bg-emerald-50 text-emerald-600',
    hover: 'hover:border-emerald-200',
  },
  amber: { tile: 'bg-amber-50 text-amber-600', hover: 'hover:border-amber-200' },
  red: { tile: 'bg-red-50 text-red-600', hover: 'hover:border-red-200' },
};
const a = accents[accent] ?? accents.blue;
---

<article
  class:list={[
    'flex h-full flex-col rounded-xl border border-border bg-canvas p-7 transition-colors duration-200 sm:p-8',
    a.hover,
  ]}
>
  {
    icon && (
      <span
        class:list={[
          'inline-flex h-11 w-11 items-center justify-center rounded-lg',
          a.tile,
        ]}
      >
        <Icon name={icon} />
      </span>
    )
  }
  <h3 class="mt-5 text-lg font-semibold text-ink">{title}</h3>
  <p class="mt-2 text-[15px] leading-relaxed text-body">{description}</p>
  {
    items.length > 0 && (
      <ul class="mt-5 space-y-2.5 border-t border-border/70 pt-5">
        {items.map(item => (
          <li class="flex items-start gap-2.5 text-sm text-body">
            <svg
              class:list={['mt-0.5 h-4 w-4 shrink-0', a.tile.split(' ')[1]]}
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m5 10 3.5 3.5L15 6.5" />
            </svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    )
  }
</article>
