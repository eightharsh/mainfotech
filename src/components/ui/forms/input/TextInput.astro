---
const { label, id, name, required = true } = Astro.props;

interface Props {
  label: string;
  name: string;
  id: string;
  required?: boolean;
}
---

<div>
  <label for={id} class="sr-only">{label}</label>
  <input
    type="text"
    name={name}
    id={id}
    required={required}
    class="focus:border-ink block min-h-11 w-full rounded-xl border border-neutral-200 bg-neutral-50 px-4 py-3 text-base text-neutral-700 placeholder:text-neutral-500 focus:ring-3 focus:ring-neutral-200 focus:outline-hidden disabled:pointer-events-none disabled:opacity-50 sm:text-sm dark:border-neutral-600 dark:bg-neutral-700/30 dark:text-neutral-300 dark:placeholder:text-neutral-400 dark:focus:ring-1"
    placeholder={label}
  />
</div>
