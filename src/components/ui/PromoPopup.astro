---
import { Image } from 'astro:assets';
import { CONTACT } from '@data/constants';
import imgPromo from '@images/popup.jpeg';
---

<div
  id="promo-popup"
  class="fixed inset-0 z-100 hidden items-center justify-center p-3 sm:p-4"
  role="dialog"
  aria-modal="true"
  aria-label="Special offer"
>
  <div
    id="promo-popup-backdrop"
    class="absolute inset-0 bg-black/60 backdrop-blur-sm"
  >
  </div>

  <div
    id="promo-popup-card"
    class="relative flex max-h-[88dvh] w-full max-w-sm scale-95 flex-col rounded-2xl bg-white opacity-0 shadow-2xl transition-all duration-300 sm:max-h-[85dvh] sm:max-w-md"
  >
    <button
      id="promo-popup-close"
      type="button"
      aria-label="Close"
      class="text-ink absolute top-3 right-3 z-10 inline-flex h-9 w-9 shrink-0 touch-manipulation items-center justify-center rounded-full bg-white shadow-[0_2px_10px_rgba(0,0,0,0.35)] ring-1 ring-black/15 transition-transform active:scale-95 sm:hover:scale-105"
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.6"
        stroke-linecap="round"
        stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"></path></svg
      >
    </button>

    <a
      href={CONTACT.whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="block min-h-0 overflow-hidden rounded-2xl"
    >
      <Image
        src={imgPromo}
        alt="MA Infotech — Borivali & Kandivali repair and services, 14+ years experience. Call 7021209087"
        width={896}
        densities={[1, 1.5, 2]}
        quality={90}
        loading="eager"
        class="max-h-[88dvh] w-full rounded-2xl object-contain sm:max-h-[85dvh]"
      />
    </a>
  </div>
</div>

<script>
  function initPromoPopup() {
    const popup = document.getElementById('promo-popup');
    if (!popup) return;

    const card = document.getElementById('promo-popup-card');
    const closeBtn = document.getElementById('promo-popup-close');
    const backdrop = document.getElementById('promo-popup-backdrop');
    const STORAGE_KEY = 'maPromoPopupShown';

    if (sessionStorage.getItem(STORAGE_KEY)) return;
    // Desktop/tablet only — skip on mobile widths.
    if (!window.matchMedia('(min-width: 640px)').matches) return;

    const open = () => {
      popup.classList.remove('hidden');
      popup.classList.add('flex');
      requestAnimationFrame(() => {
        card?.classList.remove('scale-95', 'opacity-0');
        card?.classList.add('scale-100', 'opacity-100');
      });
      document.body.style.overflow = 'hidden';
      sessionStorage.setItem(STORAGE_KEY, '1');
    };

    const close = () => {
      card?.classList.add('scale-95', 'opacity-0');
      card?.classList.remove('scale-100', 'opacity-100');
      document.body.style.overflow = '';
      setTimeout(() => {
        popup.classList.add('hidden');
        popup.classList.remove('flex');
      }, 200);
      document.removeEventListener('keydown', onKeydown);
    };

    const onKeydown = (e: KeyboardEvent) => {
      if (e.key === 'Escape') close();
    };

    closeBtn?.addEventListener('click', close);
    backdrop?.addEventListener('click', close);
    document.addEventListener('keydown', onKeydown);

    setTimeout(open, 1000);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPromoPopup);
  } else {
    initPromoPopup();
  }
  document.addEventListener('astro:page-load', initPromoPopup);
</script>
