---
// Importing necessary components
import Meta from '@components/Meta.astro';
import Navbar from '@components/sections/navbar&footer/Navbar.astro';
import FooterSection from '@components/sections/navbar&footer/FooterSection.astro';
import MobileActionBar from '@components/ui/MobileActionBar.astro';
import BrandLogo from '@components/BrandLogo.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import { ClientRouter } from 'astro:transitions';
import { SITE } from '@data/constants';
import '@styles/global.css';

// GA4 measurement ID is provided via PUBLIC_GA_MEASUREMENT_ID env var
const GA_MEASUREMENT_ID = import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? null;

// Setting expected props
const {
  title = SITE.title,
  meta,
  structuredData,
  post = null,
  ogImage = null,
  ogImageUrl = null,
  ogImageAlt = null,
  preloadImage = null,
  preloadImages = null,
  lang = 'en',
  customDescription = null,
  customOgTitle = null,
  hideFooter = false,
  fullWidth = false,
  overlayNav = false,
} = Astro.props;

// Interface to type-check the properties
interface Props {
  title?: string;
  meta?: string;
  structuredData?: object;
  post?: any;
  /** Article card image metadata — used for Open Graph / Twitter share previews */
  ogImage?: any;
  /** Absolute https URL for share preview (preferred when available) */
  ogImageUrl?: string | null;
  ogImageAlt?: string | null;
  preloadImage?: string | null;
  preloadImages?: Array<{ href: string; media?: string }> | null;
  lang?: string;
  customDescription?: string | null;
  customOgTitle?: string | null;
  hideFooter?: boolean;
  fullWidth?: boolean;
  overlayNav?: boolean;
}
---

<html lang={lang} class="scroll-pt-20 md:scroll-pt-32">
  <head>
    <script is:inline>
      document.documentElement.classList.add('js');
      // Detect installed-app (standalone) launch so we can show a branded splash
      // on cold start only — never in the browser, so website LCP is unaffected.
      (function () {
        try {
          var standalone =
            window.matchMedia('(display-mode: standalone)').matches ||
            window.navigator.standalone === true;
          if (standalone) {
            document.documentElement.classList.add('pwa-standalone');
            if (!sessionStorage.getItem('maSplashShown')) {
              document.documentElement.classList.add('show-splash');
            }
          }
        } catch (e) {}
      })();
    </script>
    <ClientRouter />
    {
      /* Inter — body · Sora — display headlines.
        Loaded non-render-blocking: preload as style, then swap to stylesheet on
        load so text paints immediately (font-display:swap handles the swap). */
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@500;600;700;800&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@500;600;700;800&display=swap"
        rel="stylesheet"
      />
    </noscript>
    {/* Adding metadata to the HTML document */}
    <Meta
      title={title}
      meta={meta}
      structuredData={structuredData}
      customDescription={customDescription}
      customOgTitle={customOgTitle}
      post={post}
      ogImage={ogImage}
      ogImageUrl={ogImageUrl}
      ogImageAlt={ogImageAlt}
      preloadImage={preloadImage}
      preloadImages={preloadImages}
    />
    {
      /* Google Analytics 4 (optional) - inject when PUBLIC_GA_MEASUREMENT_ID is set */
    }
    {
      GA_MEASUREMENT_ID && (
        <>
          <script
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}
          />
          <script
            set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js', new Date());gtag('config','${GA_MEASUREMENT_ID}');`}
          />
        </>
      )
    }
    {/* Title is set in Meta component */}

    <script>
      import '@scripts/siteBootstrap.js';
    </script>
  </head>
  <body class="bg-canvas text-ink selection:bg-ink selection:text-white">
    {/* Top loading bar — visible feedback while a page navigation is in flight.
       transition:persist keeps this exact element across navigations so our
       cached reference below never goes stale mid-transition. */}
    <div id="page-progress" aria-hidden="true" transition:persist></div>
    <script is:inline>
      (function () {
        if (window.__pageProgressInit) return;
        window.__pageProgressInit = true;

        var creepTimer = null;
        var hideTimer = null;

        function bar() {
          // Re-queried each call (not cached) as a defensive fallback in case
          // the persisted element is ever replaced by an Astro page-swap.
          return document.getElementById('page-progress');
        }

        function setWidth(pct) {
          var el = bar();
          if (el) el.style.width = pct + '%';
        }

        function start() {
          var el = bar();
          if (!el) return;
          clearTimeout(hideTimer);
          clearInterval(creepTimer);
          el.style.transition = 'none';
          setWidth(0);
          el.classList.add('is-active');
          // Force reflow so the 0% state is committed before animating.
          void el.offsetWidth;
          el.style.transition = '';
          requestAnimationFrame(function () {
            setWidth(35);
          });
          var pct = 35;
          creepTimer = setInterval(function () {
            pct = Math.min(pct + (90 - pct) * 0.15, 90);
            setWidth(pct);
          }, 300);
        }

        function finish() {
          var el = bar();
          if (!el) return;
          clearInterval(creepTimer);
          setWidth(100);
          hideTimer = setTimeout(function () {
            el.classList.remove('is-active');
            hideTimer = setTimeout(function () {
              el.style.transition = 'none';
              setWidth(0);
              void el.offsetWidth;
              el.style.transition = '';
            }, 250);
          }, 150);
        }

        document.addEventListener('astro:before-preparation', start);
        document.addEventListener('astro:page-load', finish);
      })();
    </script>
    {
      /* Branded launch splash — visible only in installed-app (standalone) mode */
    }
    <div id="app-splash" aria-hidden="true">
      <div class="app-splash__inner">
        <BrandLogo class="app-splash__logo h-14 w-auto" />
        <span class="app-splash__bar"></span>
      </div>
    </div>
    <div id="site-scroll">
      <div id="site-scroll-content" class="relative flex min-h-dvh flex-col">
        <a
          href="#main-content"
          class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-100 focus:rounded-lg focus:bg-[#1E3AFF] focus:px-4 focus:py-2 focus:text-neutral-50"
        >
          Skip to content
        </a>

        <Navbar overlay={overlayNav} transition:persist="site-navbar" />
        <main id="main-content" class="relative z-10 w-full grow">
          <slot />
        </main>
        {!hideFooter && <FooterSection transition:persist />}
        {/* Spacer so the mobile action bar never covers footer content */}
        <div class="h-24 md:hidden" aria-hidden="true"></div>
      </div>
    </div>
    <MobileActionBar />
    {/* Fade out the launch splash once the app is ready (standalone only) */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        if (!root.classList.contains('show-splash')) return;
        var hide = function () {
          var s = document.getElementById('app-splash');
          root.classList.remove('show-splash');
          try {
            sessionStorage.setItem('maSplashShown', '1');
          } catch (e) {}
          if (!s) return;
          setTimeout(function () {
            s.classList.add('is-hidden');
            setTimeout(function () {
              if (s && s.parentNode) s.parentNode.removeChild(s);
            }, 500);
          }, 300);
        };
        if (document.readyState === 'complete') hide();
        else window.addEventListener('load', hide);
      })();
    </script>
    <Analytics />
    <SpeedInsights />
    <script>
      // https://preline.co
      import 'preline';
      const initPreline = () =>
        (
          window as Window & { HSStaticMethods?: { autoInit?: () => void } }
        ).HSStaticMethods?.autoInit?.();
      if (document.readyState === 'loading')
        document.addEventListener('DOMContentLoaded', initPreline);
      else initPreline();
      document.addEventListener('astro:page-load', initPreline);
    </script>
    <style>
      /* CSS rules for the page scrollbar */
      .scrollbar-hide::-webkit-scrollbar {
        display: none;
      }

      .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }

      @media (prefers-reduced-motion: no-preference) {
        ::view-transition-group(root) {
          animation-duration: 320ms;
          animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
        }

        ::view-transition-old(root) {
          animation: 180ms ease-out both mi-page-out;
        }

        ::view-transition-new(root) {
          animation: 320ms cubic-bezier(0.22, 1, 0.36, 1) both mi-page-in;
        }
      }

      @keyframes mi-page-out {
        from {
          opacity: 1;
          transform: translateY(0);
        }

        to {
          opacity: 0;
          transform: translateY(-6px);
        }
      }

      @keyframes mi-page-in {
        from {
          opacity: 0;
          transform: translateY(10px);
        }

        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* Top loading bar shown during page navigations (astro:transitions). */
      #page-progress {
        position: fixed;
        top: 0;
        left: 0;
        z-index: 200;
        height: 3px;
        width: 0%;
        background: linear-gradient(90deg, #1e3a8a, #2563eb, #ef4444);
        opacity: 0;
        transition:
          width 300ms ease-out,
          opacity 200ms ease-out;
        pointer-events: none;
      }

      #page-progress.is-active {
        opacity: 1;
      }

      @media (prefers-reduced-motion: reduce) {
        #page-progress {
          transition: opacity 200ms ease-out;
        }
      }
    </style>
  </body>
</html>
